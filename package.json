{
  "name": "prisgjett-mobil",
  "private": true,
  "description": "Prisgjett for mobil og nettbrett (PWA)",
  "scripts": {
    "test": "npm run test:py && npm run test:e2e",
    "test:py": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:e2e": "node --test --test-concurrency=2 \"tests/e2e/*.test.mjs\"",
    "data": "python3 scraper/bygg_data.py",
    "start": "cd app && python3 -m http.server 8000"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
